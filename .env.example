# Copier ce fichier vers .env (racine) et backend/.env, puis remplacer toutes les valeurs.
# Générer un secret : python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_DB=depistage_app
POSTGRES_USER=depistage_app
POSTGRES_PASSWORD=changez-moi
DATABASE_URL=postgresql+psycopg://depistage_app:changez-moi@db:5432/depistage_app
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost,http://localhost:5173
ALLOW_PUBLIC_REGISTRATION=false
ANALYTICS_MIN_GROUP_SIZE=5
ANALYTICS_PSEUDONYM_SECRET=
FRONTEND_URL=http://localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
INVITATION_EXPIRE_HOURS=72
ALLOWED_EMAIL_DOMAINS=
ENVIRONMENT=development
REQUEST_RATE_LIMIT_PER_MINUTE=10
